# FleetVu Enterprise Environment Configuration
# Copy relevant keys into .env — never commit secrets.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Corporate Email Dispatch ---
# Identities (fixed): support@ | welcome@ | safetyreport@ | notice@ fleetvu.org
EMAIL_DRY_RUN=true

# Preferred: SMTP pool (connection pooling + STARTTLS + AUTH LOGIN)
SMTP_HOST=mail.fleetvu.org
SMTP_PORT=465
SMTP_USER=welcome@fleetvu.org
SMTP_PASS=
SMTP_SECURE=true
SMTP_MAX_CONNECTIONS=5
SMTP_TIMEOUT_MS=15000
SMTP_TLS_REJECT_UNAUTHORIZED=false

# Fallback: Resend HTTP API
EMAIL_SERVICE_API_KEY=
RESEND_API_KEY=
RESEND_TIMEOUT_MS=12000
RESEND_MAX_CONCURRENT=4

# Legacy single-sender (overridden by identity routing)
SENDER_EMAIL=welcome@fleetvu.org
